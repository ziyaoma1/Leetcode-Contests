class Solution:
    def sortVowels(self, s: str) -> str:
        vowels = "aeiou"
        counter = Counter(s)
        counter = dict(sorted(counter.items(), key=lambda item: item[1], reverse=True))
        res = ""
        i = 0
        temp = ""
        for item in counter:
            if item in vowels:
                temp += item*counter[item]
        while i < len(s):
            if not s[i] in vowels:
                res = res + s[i]
            else:
                res = res + temp[0]
                temp = temp[1:]
            i += 1
        return res
