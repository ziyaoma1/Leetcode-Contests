class Solution:
    def minCost(self, nums1: list[int], nums2: list[int]) -> int:
        count1 = Counter(nums1)
        count2 = Counter(nums2)
        res = 0
        for key in count1:
            if key in count2:
                temp = count1[key]
                count1[key] -= count2[key]
                count2[key] -= temp
            if (count1[key] % 2) != 0:
                return -1
            res += max(0, count1[key])
        for key in count2:
            if count2[key] % 2 != 0:
                return -1
        return res // 2
